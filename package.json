{
  "name": "html-blocker",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@10.29.2",
  "description": "Automatically remove intrusive HTML elements from websites",
  "author": "LouisMazel <me@loicmazuel.com>",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "modal-blocker",
    "adblock"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "pre-commit": "lint-staged",
    "lint": "pnpm lint:js && pnpm lint:style",
    "lint:fix": "pnpm lint:js --fix && pnpm lint:style --fix",
    "lint:js": "cross-env NODE_ENV=production eslint .",
    "lint:style": "stylelint \"./**/*.{css,scss,postcss,pcss,html}\"",
    "relizy": "relizy",
    "release": "pnpm lint && pnpm typecheck && pnpm build && pnpm relizy release",
    "release:beta": "pnpm lint && pnpm typecheck && pnpm build && pnpm relizy release --prerelease --preid beta --tag beta",
    "release:alpha": "pnpm lint && pnpm typecheck && pnpm build && pnpm relizy release --prerelease --preid alpha --tag alpha --no-git-tag --no-push --no-commit --no-changelog --no-social --no-provider-release --no-publish --force --no-clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@commitlint/types": "^20.4.0",
    "@crxjs/vite-plugin": "^2.0.0-beta.21",
    "@maz-ui/eslint-config": "^4.6.1",
    "@types/chrome": "^0.1.36",
    "@types/node": "^25.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "relizy": "^1.0.1",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1"
  },
  "pnpm": {
    "overrides": {
      "jiti": "^2.6.1"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,mts,cjs,md,yml,json}": "cross-env NODE_ENV=production eslint --fix",
    "*.{vue,css,scss,postcss,pcss}": "stylelint --fix --allow-empty-input"
  }
}
